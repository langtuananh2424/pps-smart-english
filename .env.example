POSTGRES_DB=pps
POSTGRES_USER=pps
POSTGRES_PASSWORD=change-me

# Production only (docker-compose.prod.yml)
# production dùng APP_ENV=production, WEB_PORT=8090, TAG=prod-latest
APP_ENV=staging
WEB_PORT=8091
IMAGE_PREFIX=ghcr.io/langtuananh2424/pps-smart-english
TAG=staging-latest

# Backend (bắt buộc ở production; dev có giá trị mặc định trong docker-compose.yml)
JWT_SECRET=change-me-at-least-32-bytes-long-secret
# JWT_SECRET_PREVIOUS=            # khóa cũ khi xoay JWT_SECRET
# production
REDIS_PASSWORD=change-me
APP_BASE_URL=http://localhost:3000
# rỗng thì đăng nhập Google trả 503
GOOGLE_CLIENT_ID=
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@localhost
# MinIO lưu video (docker-compose.prod.yml bắt buộc; dev có mặc định minioadmin)
# staging dùng MINIO_PORT=9191, production dùng MINIO_PORT=9190
MINIO_PORT=9191
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars
# URL công khai của MinIO mà trình duyệt truy cập được, dùng để ký link video
MINIO_PUBLIC_URL=http://localhost:9100
# Cổng thanh toán giả (endpoint /api/dev/payments và webhook ký HMAC). Dev compose bật mặc định; prod compose tắt mặc định.
# Chưa có cổng thật: tắt thì tạo đơn trả 503 payment_unavailable. Bật thì PAYMENT_FAKE_SECRET là bắt buộc.
# Để trống dòng dưới thì dùng mặc định của từng compose; bỏ dấu # để ép giá trị.
# PAYMENT_FAKE_ENABLED=false
# PAYMENT_FAKE_SECRET=change-me
# Chấm AI. Dev compose mặc định fake (kết quả cố định); prod compose mặc định anthropic và bắt buộc có khóa API.
# AI_PROVIDER=fake
# AI_MODEL=claude-haiku-5-5
# ANTHROPIC_API_KEY=
# Web Push (VAPID). Thiếu khóa thì tắt push, thông báo trong ứng dụng vẫn chạy. Sinh khóa: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.com
# Dữ liệu demo danh mục (db/demo). Dev compose bật mặc định (đặt rỗng để tắt); prod compose tắt mặc định.
# Staging muốn xem demo thì bỏ dấu # (giá trị bắt đầu bằng dấu phẩy):
# DEMO_FLYWAY_LOCATION=,classpath:db/demo
