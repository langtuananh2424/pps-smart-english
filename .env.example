POSTGRES_DB=pps
POSTGRES_USER=pps
POSTGRES_PASSWORD=change-me

# Production only (docker-compose.prod.yml)
IMAGE_PREFIX=ghcr.io/langtuananh2424/pps-smart-english
TAG=latest

# Backend (bắt buộc ở production; dev có giá trị mặc định trong docker-compose.yml)
JWT_SECRET=change-me-at-least-32-bytes-long-secret
# JWT_SECRET_PREVIOUS=            # khóa cũ khi xoay JWT_SECRET
# production
REDIS_PASSWORD=change-me
APP_BASE_URL=http://localhost:3000
# rỗng thì đăng nhập Google trả 503
GOOGLE_CLIENT_ID=
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@localhost
